# ==============================================================================
# ComicCraft Environment Configuration
# ==============================================================================

# Environment: development | staging | production | test
ENVIRONMENT=development

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# AI Models (official Google Gen AI SDK)
OUTLINE_MODEL=gemini-2.5-flash
STORY_MODEL=gemini-2.5-flash
IMAGE_MODEL=imagen-3.0-generate-002

# Image Provider: gemini | diffusers
IMAGE_PROVIDER=gemini

# Database URL (SQLite async with aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./comiccraft.db

# Storage Directory for generated panel images and PDFs
STORAGE_DIR=./storage

# Concurrency & Rate Limiting
IMAGE_CONCURRENCY_LIMIT=3
RATE_LIMIT=60/minute

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
